# Econumo environment for a host managed by ship. `ship install` copies this to
# /etc/<service>/econumo.env (root:<service>, 0640) only when that file does not
# exist yet; edit it there and `ship restart econumo` to apply.
#
# Every setting in the repository's docs/full.env.example works here too
# (registration, email, sign-in providers, …).

# The service runs in its data directory (/var/lib/<service>), so this relative
# path keeps the SQLite database there whatever the service is called. For
# PostgreSQL use e.g. postgres://user:pass@host:5432/econumo?sslmode=disable
DATABASE_URL=sqlite://db.sqlite

# HTTP listen port. The service runs unprivileged, so keep it above 1024 and put
# a reverse proxy (TLS) in front.
PORT=8181
