# Econumo configuration. Copy to .env and adjust:
#
#   cp .env.example .env
#
# These are the settings most self-hosted setups need. Every other setting
# (email, sign-in options, AI, imports, rate limits, ...) is described in
# docs/full.env.example. Never commit .env: it may hold secrets.

# Database. SQLite works out of the box; for PostgreSQL:
#   DATABASE_URL=postgres://econumo:econumo@postgres:5432/econumo?sslmode=disable
DATABASE_URL=sqlite:///app/var/db/db.sqlite

# HTTP port inside the container (compose maps 8181:80). Without Docker use
# e.g. 8181.
PORT=80

# Allow new users to sign up. Turn it off once everyone has an account.
ECONUMO_ALLOW_REGISTRATION=true

# Currencies (https://econumo.com/docs/self-hosting/multi-currency/).
# Base currency, plus an Open Exchange Rates token to get exchange rates,
# refreshed every N days (1-31).
# ECONUMO_CURRENCY_BASE=USD
# OPEN_EXCHANGE_RATES_TOKEN=
# ECONUMO_CURRENCY_UPDATE_INTERVAL=1

# Daily check for new Econumo releases (one request to econumo.com).
# ECONUMO_CHECK_UPDATES=false

# Single sign-on through your own OpenID Connect provider (Authentik,
# Keycloak, ...). Needs this instance's public URL; register
# <ECONUMO_URL>/api/v1/oauth/callback-oidc as the callback with the provider.
# Google and Apple sign-in: see docs/full.env.example and docs/oidc-setup.md.
# ECONUMO_URL=https://money.example.com
# ECONUMO_OIDC_ISSUER_URL=https://auth.example.com/application/o/econumo/
# ECONUMO_OIDC_CLIENT_ID=
# ECONUMO_OIDC_CLIENT_SECRET=
# ECONUMO_OIDC_NAME=SSO
