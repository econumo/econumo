# Econumo configuration: full reference of every setting.
#
# The root .env.example holds the settings most self-hosted setups need; copy
# any line from here into your .env to use it. Values below are for Docker.

# =============================================================================
# Essentials
# =============================================================================

# Database (required). Docker default below; for `go run` use e.g.
# sqlite://var/db/db.sqlite. For PostgreSQL:
#   DATABASE_URL=postgres://econumo:econumo@postgres:5432/econumo?sslmode=disable
DATABASE_URL=sqlite:///app/var/db/db.sqlite

# HTTP port (required). Keep 80 for Docker (compose maps 8181:80); use e.g.
# 8181 for `go run`.
PORT=80

# Public URL of this instance. Adds a link to every email, and is required for
# "Sign in with..." providers. As an https origin with no path (plain http only
# on localhost) it also lets AI apps connect to /mcp by signing in; apps using a
# personal access token do not need it.
# ECONUMO_URL=https://money.example.com

# Allow new users to sign up.
ECONUMO_ALLOW_REGISTRATION=true

# Email delivery (password reset, verification codes). Empty = print emails to
# stdout. Percent-encode special characters in the password (@ -> %40).
#   resend://<api_key>?from=...           Resend
#   smtp://user:pass@host[:587]?from=...  SMTP with STARTTLS
#   smtps://user:pass@host[:465]?from=... SMTP over TLS
# Add &insecure=true only for a relay without TLS on a trusted network.
# MAILER_DSN=resend://re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx?from=noreply@yourdomain.com&reply_to=support@yourdomain.com
# MAILER_DSN=smtp://apikey:secret@smtp-relay.brevo.com:587?from=Econumo%20%3Cnoreply@yourdomain.com%3E&reply_to=support@yourdomain.com
# MAILER_DSN=smtp://postfix:25?from=noreply@yourdomain.com&insecure=true

# Currencies (https://econumo.com/docs/self-hosting/multi-currency/).
# Exchange rates come from Open Exchange Rates. Set the interval (1-31 days) to
# refresh them automatically (needs the token); leave it unset to run currency:update-rates from
# your own cron.
# ECONUMO_CURRENCY_BASE=USD
# OPEN_EXCHANGE_RATES_TOKEN=
# ECONUMO_CURRENCY_UPDATE_INTERVAL=1

# Behind a reverse proxy: the header carrying the client IP (e.g.
# CF-Connecting-IP), so rate limits count each user separately. Make sure only
# the proxy can reach this server, or list the proxies' IPs/CIDRs below
# (with only the list set, the header is X-Forwarded-For).
#ECONUMO_CLIENT_IP_HEADER=
#ECONUMO_CLIENT_IP_TRUSTED_PROXIES=

# =============================================================================
# Sign-in
# =============================================================================

# Require new users to confirm their email with a code at first login.
#ECONUMO_EMAIL_VERIFICATION=false

# Email + password sign-in. false leaves only the providers below (at least one
# is required); link a provider to every existing account first.
#ECONUMO_PASSWORD_LOGIN=true

# Sign in with Google / Apple / OpenID Connect. Each provider needs all of its
# variables and ECONUMO_URL. Callback URL to register with the provider:
# <ECONUMO_URL>/api/v1/oauth/callback-<google|apple|oidc>. See docs/oidc-setup.md.
# ECONUMO_OAUTH_GOOGLE_CLIENT_ID=
# ECONUMO_OAUTH_GOOGLE_CLIENT_SECRET=
# ECONUMO_OAUTH_APPLE_CLIENT_ID=        # the Services ID
# ECONUMO_OAUTH_APPLE_TEAM_ID=
# ECONUMO_OAUTH_APPLE_KEY_ID=
# ECONUMO_OAUTH_APPLE_PRIVATE_KEY_FILE= # path to the .p8 file
# ECONUMO_OIDC_ISSUER_URL=https://auth.example.com/application/o/econumo/
# ECONUMO_OIDC_CLIENT_ID=
# ECONUMO_OIDC_CLIENT_SECRET=
# ECONUMO_OIDC_NAME=SSO
# ECONUMO_OIDC_SCOPES=openid,profile,email
# ECONUMO_OIDC_TRUST_EMAIL=false        # true if your IdP never sends email_verified

# =============================================================================
# Optional features
# =============================================================================

# AI provider, used to pick icons and spot savings accounts during onboarding.
# Local runtimes need no key.
#ECONUMO_AI_DSN=openai://<api-key>@api.openai.com?model=gpt-5-mini
#ECONUMO_AI_DSN=anthropic://<api-key>@api.anthropic.com?model=claude-sonnet-4-6
#ECONUMO_AI_DSN=openai://localhost:11434?model=llama3.1

# SimpleFIN bank import. Apple Wallet and CSV import are always on.
#ECONUMO_IMPORT_SIMPLEFIN=false
# Let SimpleFIN reach private/LAN addresses (only for a bridge on your network).
#ECONUMO_IMPORT_ALLOW_PRIVATE_HOSTS=false

# In-app "Send feedback" form (sent from the browser to econumo.com).
#ECONUMO_FEEDBACK=true

# Daily check for new releases (one request to econumo.com).
# ECONUMO_CHECK_UPDATES=false

# Show the "use my own server" option on the login and sign-up pages.
# ECONUMO_ALLOW_CUSTOM_API=false

# =============================================================================
# Advanced
# =============================================================================

# Log level: debug | info | warn | error. Commands also take -v/-vv/-vvv and -q.
# ECONUMO_LOG_LEVEL=info

# Allowed cross-origin browser origins (comma-separated, or *). Not needed when
# the app is served by this server. For the Vite dev server:
# ECONUMO_CORS_ALLOW_ORIGIN=http://localhost:9000

# Rate limits (0 = off). Sign-in limits count per email address and client IP.
#ECONUMO_RATE_LIMIT_WINDOW=15m           # window for the per-user and per-address limits
#ECONUMO_RATE_LIMIT_LOGIN=5              # failed logins
#ECONUMO_RATE_LIMIT_RESET=5              # failed password resets
#ECONUMO_RATE_LIMIT_REMIND=3             # password reset emails
#ECONUMO_RATE_LIMIT_REGISTER=5           # sign-ups
#ECONUMO_RATE_LIMIT_VERIFY_EMAIL=3       # verification code emails
#ECONUMO_RATE_LIMIT_CONFIRM_EMAIL=5      # failed verification codes
#ECONUMO_RATE_LIMIT_REQUEST_EMAIL_CHANGE=3   # email change code emails per user
#ECONUMO_RATE_LIMIT_CONFIRM_EMAIL_CHANGE=5   # failed email change codes per user
#ECONUMO_RATE_LIMIT_ACCEPT_INVITE=10     # sharing invite attempts per user
#ECONUMO_RATE_LIMIT_IP=60                # requests per endpoint per client IP per minute
#ECONUMO_RATE_LIMIT_INGEST=60            # Apple Wallet pushes per user per window
#ECONUMO_RATE_LIMIT_CLAIM_SETUP_TOKEN=5  # SimpleFIN setup-token claims per user per window
#ECONUMO_RATE_LIMIT_SYNC=10              # bank syncs per user per window
#ECONUMO_RATE_LIMIT_PREVIEW_RULE=120     # import rule previews per user per window

# Transaction-import matching.
#ECONUMO_IMPORT_MATCH_DAYS=3          # days apart a same-amount match may be (0-31)
#ECONUMO_IMPORT_TIP_DAYS=5            # days a bank record may post after a tap (0-31)
#ECONUMO_IMPORT_TIP_TOLERANCE=20      # percent the posted amount may differ, e.g. tips (0-100)
#ECONUMO_IMPORT_TOKEN_MIN_LENGTH=3    # shortest merchant name fragment to match (1-16)

# SQLite busy timeout in milliseconds.
# SQLITE_BUSY_TIMEOUT=0

# Trial for new self-registered users, in days; afterwards they become
# read-only. 0 = no trial, full access forever.
# ECONUMO_TRIAL=0

# Paid hosting: a private admin listener for a payment portal (both or
# neither; token: `openssl rand -hex 32`), and the portal URL (https) that
# the app links to for billing.
# ECONUMO_ADMIN_PORT=127.0.0.1:9090
# ECONUMO_ADMIN_TOKEN=
# ECONUMO_BILLING_URL=https://billing.example.com

# Web UI: version text shown in the app, and where liltag (tag manager)
# loads its config from.
# ECONUMO_VERSION=demo
# ECONUMO_LILTAG_CONFIG_URL=/liltag-config.json
# ECONUMO_LILTAG_CACHE_TTL=0

# Mobile app sign-in return through verified links. Only for the domain the
# mobile app is associated with (https). See docs/oidc-setup.md.
# ECONUMO_APP_LINKS_IOS=TEAMID1234.com.econumo.app          # <Team ID>.<bundle id>, comma-separated
# ECONUMO_APP_LINKS_ANDROID=com.econumo.app=AA:BB:...:ZZ    # <package>=<SHA-256 fingerprint>, comma-separated

# =============================================================================
# Deprecated
# =============================================================================

# Old email salt. Only to migrate data from before v1: back up the database,
# set your old salt, `docker compose up -d`, run
#   docker compose exec econumo /app/econumo data:remove-salt
# then remove it and `docker compose up -d` again. See docs/migration-v0-to-v1.md.
# ECONUMO_DATA_SALT=
